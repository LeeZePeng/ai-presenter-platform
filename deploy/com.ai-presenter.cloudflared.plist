<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-presenter.cloudflared</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/yshtola/ai-presenter-platform/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--no-autoupdate</string>
    <string>--protocol</string>
    <string>http2</string>
    <string>--edge-ip-version</string>
    <string>4</string>
    <string>run</string>
    <string>--dns-resolver-addrs</string>
    <string>1.1.1.1:53</string>
    <string>--token-file</string>
    <string>/Users/yshtola/ai-presenter-platform/.cloudflared/token</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/yshtola/ai-presenter-platform/logs/cloudflared.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yshtola/ai-presenter-platform/logs/cloudflared.error.log</string>
</dict>
</plist>
