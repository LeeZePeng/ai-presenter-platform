# Web server
PORT=4317
HOST=127.0.0.1
DATA_DIR=./data
APP_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=500
JOBS_ENABLED=true

# Development safety: keep both true until the UI and queue are verified.
MOCK_GPU=true
MOCK_CODEX=true

# Optional: official keyword search. Direct YouTube URL import uses yt-dlp without this key.
YOUTUBE_API_KEY=
YTDLP_BIN=/usr/local/bin/yt-dlp
FFMPEG_BIN=
YOUTUBE_PROXY_URL=
YOUTUBE_SEARCH_CANDIDATE_LIMIT=20
YOUTUBE_SEARCH_EXPANDED_LIMIT=50
YOUTUBE_SEARCH_TIMEOUT_SECONDS=120
YOUTUBE_IMPORT_TIMEOUT_MINUTES=20
YOUTUBE_MAX_DURATION_MINUTES=30

# Admin-only deployment. Keep disabled until the repository, target directory,
# package manager and launchd service have been prepared on the production Mac.
DEPLOY_ENABLED=false
DEPLOY_REPO_DIR=/path/to/ai-presenter-platform-checkout
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=main
DEPLOY_TARGET_DIR=/path/to/ai-presenter-platform-runtime
DEPLOY_SCRIPT=./deploy/deploy-macos.mjs
DEPLOY_PNPM_BIN=pnpm
DEPLOY_LAUNCHD_LABEL=com.ai-presenter.platform
DEPLOY_HEALTH_URL=http://127.0.0.1:4317/api/health
DEPLOY_HEALTH_TIMEOUT_SECONDS=90

# CompShare OpenAPI. Never commit real values.
COMPSHARE_PUBLIC_KEY=
COMPSHARE_PRIVATE_KEY=
COMPSHARE_INSTANCE_ID=
COMPSHARE_REGION=cn-wlcb
COMPSHARE_ZONE=cn-wlcb-01
COMPSHARE_BASE_URL=https://api.compshare.cn

# Billing window and GPU readiness
POWER_WINDOW_SECONDS=3600
POWER_TICK_SECONDS=15
GPU_START_TIMEOUT_SECONDS=1200
GPU_HEALTH_URL=http://106.75.239.93:7860/
AI_PRESENTER_API_URL=http://106.75.239.93:7860
AI_PRESENTER_COMFY_URL=http://106.75.239.93:8188
AI_PRESENTER_GPU_WORKERS=4
REMOTION_CONCURRENCY=16
REMOTION_CRF=12

# Source-video ASR uses ModelVerse whisper-1 first and falls back to local Metal.
PYTHON_BIN=python3.11
ASR_PROVIDER=modelverse
ASR_CLOUD_BASE_URL=https://api.modelverse.cn/v1
ASR_CLOUD_MODEL=whisper-1
ASR_CLOUD_API_KEY=
ASR_LOCAL_FALLBACK=true
ASR_CACHE_DIR=/var/lib/ai-presenter/data/asr-cache
ASR_BIN=/var/lib/ai-presenter/runtime/whisper/whisper-cli
ASR_MODEL=/var/lib/ai-presenter/runtime/whisper/ggml-small.bin
ASR_LANGUAGE=auto
ASR_THREADS=8
ASR_USE_GPU=true
ASR_TIMEOUT_MINUTES=120

# Codex worker. Authentication/provider configuration stays in CODEX_HOME.
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=xhigh
CODEX_MODEL_PROVIDER=
CODEX_PROFILE=
CODEX_SANDBOX_MODE=workspace-write
CODEX_EPHEMERAL=false
CODEX_TIMEOUT_MINUTES=180
CODEX_GOAL_MAX_MINUTES=720
AI_PRESENTER_SKILL_PATH=~/.codex/skills/ai-presenter-video-replica

# Model APIs used by the AI presenter skill
MODELVERSE_API_KEY=
HEYGEN_API_KEY=
